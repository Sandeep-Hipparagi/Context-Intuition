# ============================================================================
# VibeCore Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ============================================================================

# Runtime Data Home Directory (defaults to ~/.vibecore if not specified)
# VIBECORE_HOME=~/.vibecore

# Ephemeral Bridge Handshake Token (auto-generated in ~/.vibecore/bridge.token if left unset)
# VIBECORE_BRIDGE_TOKEN=your-random-secret-token

# Local Inference Runtime (Ollama / vLLM / llama.cpp)
LOCAL_LLM_URL=http://localhost:11434
CONFIDENCE_THRESHOLD=0.80

# Network Binding
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8000

# Optional Cloud Frontier Escalation (Pareto Routing for high-complexity multimodal synthesis)
# FRONTIER_API_KEY=
# FRONTIER_MODEL=
